{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 构建 Debug",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "saveAllFiles" 
        },
        {
            "label": "CMake: 配置 Debug",
            "type": "shell",
            "command": "cmake --preset Debug",
            "problemMatcher": [],
            "dependsOn": "saveAllFiles" 
        },
        {
            "label": "CMake: 清理并重建Debug",
            "type": "shell",
            "command": "rm -rf build/Debug && cmake --preset Debug && cmake --build --preset Debug",
            "problemMatcher": ["$gcc"],
            "group": "build",
            "dependsOn": "saveAllFiles" 
        },
        {
            "label": "CMake: 清理并重建Release",
            "type": "shell",
            "command": "rm -rf build/Release && cmake --preset Release && cmake --build --preset Release",
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "saveAllFiles" 
        },
        {
            "label": "OpenOCD: 烧录",
            "type": "shell",
            "command": "openocd -f flash.cfg",
            "problemMatcher": []
        },
        {
            "label": "saveAllFiles",
            "type": "shell",
            "command": "${command:workbench.action.files.saveAll}",
            "problemMatcher": []
        }
    ]
}